{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alfanowski/UniSkills/templates/finding-schema.json",
  "title": "UniSkills Finding",
  "description": "One defect or risk, with the evidence needed to check it. Used by code, security, and performance reviews when a machine-readable artifact is required.",
  "type": "object",
  "required": ["id", "title", "category", "severity", "priority", "confidence", "status", "location", "trigger", "mechanism", "impact", "evidence"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{1,4}-[0-9]{1,4}$",
      "description": "Stable identifier, e.g. CR-001, SEC-003."
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120,
      "description": "What is wrong, not where it is."
    },
    "category": {
      "type": "string",
      "enum": ["correctness", "contract", "resource", "concurrency", "error-handling", "security", "performance", "maintainability", "test-gap", "observability"]
    },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"],
      "description": "Impact if triggered. Independent of confidence and priority."
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"],
      "description": "Urgency in the project context."
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "Strength of the evidence for the trigger being reachable."
    },
    "status": {
      "type": "string",
      "enum": ["INTRODUCED", "PRE-EXISTING", "UNCERTAIN"],
      "description": "Whether this change caused it."
    },
    "location": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string" },
        "call_sites": { "type": "array", "items": { "type": "string" } }
      }
    },
    "trigger": {
      "type": "string",
      "minLength": 10,
      "description": "Precondition plus input or state that reaches the defect."
    },
    "mechanism": {
      "type": "string",
      "minLength": 20,
      "description": "Control/data-flow explanation of why the trigger produces the effect."
    },
    "impact": {
      "type": "string",
      "minLength": 10,
      "description": "What breaks, for whom, bounded by scope."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "pointer"],
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "enum": ["code", "test", "measurement", "tool-output", "source", "spec"] },
          "pointer": { "type": "string", "description": "path:line, test id, URL + date, or command + output reference." },
          "note": { "type": "string" }
        }
      }
    },
    "labels": {
      "type": "array",
      "items": { "type": "string", "enum": ["VERIFIED", "DERIVED", "LIKELY", "HYPOTHESIS", "SPECULATIVE", "UNKNOWN"] },
      "description": "Evidence labels that apply to the claim set."
    },
    "fix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "acceptance": { "type": "string", "description": "Test or check that fails now and passes after." },
        "tradeoff": { "type": "string" }
      }
    },
    "blocked_by": {
      "type": "string",
      "description": "Existing control that prevents exploitation, if any."
    },
    "limits": {
      "type": "array",
      "items": { "type": "string" },
      "description": "What could not be verified about this finding."
    }
  }
}
